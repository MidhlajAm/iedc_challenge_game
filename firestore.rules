rules_version = '2';

// Firestore security rules for IEDC Rush.
// Paste into Firebase console → Firestore Database → Rules → Publish.
// Also enable Authentication → Sign-in method → Anonymous.
//
// Anti-cheat design (the score is still calculated on the phone, so this
// can't be perfect — it stops editing scores in the browser console):
//   runs/{runId}        opened when a game starts; the SERVER stamps the
//                       start time, so run length can't be faked.
//   scores/{runId}      one record per submitted run (history).
//   leaderboard/{uid}   each player's all-time best. Only ever raised.
// Every submitted score must fit the time that really passed on the
// server's clock, and each run can be submitted only once.
// Players are Firebase anonymous accounts: nobody can write as someone else.
// A player's name is permanent once they are on the leaderboard.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function runPath(runId) {
      return /databases/$(database)/documents/runs/$(runId);
    }

    // Same name as the player's existing leaderboard entry (if they have one)
    function keepsName(data) {
      let entry = /databases/$(database)/documents/leaderboard/$(request.auth.uid);
      return !exists(entry) || get(entry).data.name == data.name;
    }

    // --- Runs: opened at game start, closed once when the score is sent ---
    match /runs/{runId} {
      allow create: if signedIn() &&
        request.resource.data.keys().hasOnly(['uid', 'startedAt', 'used']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.startedAt == request.time &&
        request.resource.data.used == false;

      allow update: if signedIn() &&
        resource.data.uid == request.auth.uid &&
        resource.data.used == false &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        request.resource.data.used == true;

      allow read, delete: if false;
    }

    // A score for run `runId`, sent in the same batch that closes the run
    function validScore(data, runId) {
      let run = get(runPath(runId)).data;
      let seconds = (request.time - run.startedAt).seconds();
      return
        data.keys().hasOnly(['name', 'score', 'duration', 'uid', 'run', 'timestamp']) &&
        data.keys().hasAll(['name', 'score', 'duration', 'uid', 'run', 'timestamp']) &&

        // Name: 2-16 letters, digits, spaces, . _ - (same rule as the game)
        data.name is string &&
        data.name.matches('^[A-Za-z0-9 ._-]{2,16}$') &&

        // The run belongs to this player, is still open, and is closed by this batch
        data.uid == request.auth.uid &&
        data.run == runId &&
        run.uid == request.auth.uid &&
        run.used == false &&
        getAfter(runPath(runId)).data.used == true &&

        // Real run length, measured by the server (at most 30 minutes)
        seconds >= 1 &&
        seconds <= 1800 &&
        data.duration is int &&
        data.duration >= 1 &&
        data.duration <= seconds + 5 &&

        // Score must be possible in that time: at most 200 points per real
        // second (+300 slack). Normal play is well under 150.
        data.score is int &&
        data.score >= 0 &&
        data.score <= seconds * 200 + 300 &&

        data.timestamp == request.time;
    }

    // --- History: one record per submitted run ---
    match /scores/{runId} {
      allow read: if true;
      allow create: if signedIn() && validScore(request.resource.data, runId) &&
        keepsName(request.resource.data);
      allow update, delete: if false;
    }

    // --- All-time best per player ---
    match /leaderboard/{uid} {
      allow read: if true;

      allow create: if signedIn() &&
        uid == request.auth.uid &&
        validScore(request.resource.data, request.resource.data.run);

      allow update: if signedIn() &&
        uid == request.auth.uid &&
        validScore(request.resource.data, request.resource.data.run) &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.score > resource.data.score;

      allow delete: if false;
    }

    // Everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
